# ─── ForgeOS environment variables ────────────────────────────────────────────
# Copy to .env.local for development. In Vercel, set these per environment
# (Development / Preview = staging / Production). Never commit real values.

# Public URL of this app (used in email links and invite links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Project Settings → API). The anon key is safe for the browser;
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS — used ONLY by the scheduled-checks cron route.
# Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for /api/cron/checks (Vercel Cron sends it as a Bearer token).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Transactional email via Resend (optional). Without these, invitations show a
# copyable link instead of emailing, and the app says so.
RESEND_API_KEY=
EMAIL_FROM="ForgeOS <no-reply@yourdomain.com>"

# Google sign-in (optional). Enable the Google provider in Supabase Auth first.
GOOGLE_AUTH_ENABLED=false

# ─── Billing: Paystack (optional) ─────────────────────────────────────────────
# Without the secret key, Admin → Billing shows plans and the trial but says online
# payments aren't switched on. Use sk_test_… on staging, sk_live_… in production.
# Webhook URL to paste in Paystack → Settings → API Keys & Webhooks:
#   https://<your-app>/api/billing/paystack/webhook   (signed with this same secret key)
PAYSTACK_SECRET_KEY=
# Optional Paystack plan codes (PLN_…) for automatic monthly renewal. Leave empty for
# one-off monthly payments.
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_GROWTH=
PAYSTACK_PLAN_PROFESSIONAL=

# ─── AI Copilot (optional) — any OpenAI-compatible Chat Completions API ───────
# e.g. AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini
# Without these the copilot says it's switched off; Insights & Forecasts still work.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ─── WhatsApp Cloud API (optional, Meta for Developers) ───────────────────────
# Webhook URL: https://<your-app>/api/whatsapp/webhook  (verify token = WHATSAPP_VERIFY_TOKEN)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── Tests only ───────────────────────────────────────────────────────────────
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54322/postgres
# BASE_URL=http://localhost:3000
