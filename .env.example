# ─── ForgeOS environment variables ────────────────────────────────────────────
# Copy to .env.local for development. In Vercel, set these per environment
# (Development / Preview = staging / Production). Never commit real values.

# Public URL of this app (used in email links and invite links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Project Settings → API). The anon key is safe for the browser;
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS — used ONLY by the scheduled-checks cron route.
# Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for /api/cron/checks (Vercel Cron sends it as a Bearer token).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Transactional email via Resend (optional). Without these, invitations show a
# copyable link instead of emailing, and the app says so.
RESEND_API_KEY=
EMAIL_FROM="ForgeOS <no-reply@yourdomain.com>"

# Google sign-in (optional). Enable the Google provider in Supabase Auth first.
GOOGLE_AUTH_ENABLED=false

# ─── Not used yet (reserved for upcoming modules; leave empty) ────────────────
# Billing (P1): PAYSTACK_SECRET_KEY, PAYSTACK_PUBLIC_KEY, PAYSTACK_WEBHOOK_SECRET, FLUTTERWAVE_SECRET_KEY
# AI Copilot (P2): AI_BASE_URL, AI_API_KEY, AI_MODEL, AI_MONTHLY_TOKEN_LIMIT
# WhatsApp (P2): WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_VERIFY_TOKEN

# ─── Tests only ───────────────────────────────────────────────────────────────
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54322/postgres
# BASE_URL=http://localhost:3000
